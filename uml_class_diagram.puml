@startuml
!theme plain
skinparam classAttributeIconSize 0

' Базовый класс
class CamelModel {
  + model_config: ConfigDict
}

' Модели данных
class Role {
  + id: int
  + name: str
  + description: str | None
}

class User {
  + id: int
  + email: str
  + hashed_password: str
  + is_active: bool
  + created_at: str | None
  + role_id: int
}

class PropertyType {
  + id: int
  + name: str
}

class RealEstateObject {
  + id: int
  + property_type_id: int
  + total_area: float
  + finishing: str
  + wall_material: str
  + floor: int
  + floors_total: int
  + price: Decimal
  + discount_price: Decimal | None
  + status: str
  + address: str
  + description: str | None
  + created_at: str | None
  + updated_at: str | None
}

class Photo {
  + id: int
  + real_estate_object_id: int
  + file_path: str
  + filename: str
  + uploaded_at: str | None
}

class Document {
  + id: int
  + real_estate_object_id: int
  + file_path: str
  + filename: str
  + doc_type: str
  + uploaded_at: str | None
}

class Contract {
  + id: int
  + real_estate_object_id: int
  + user_id: int
  + manager_id: int
  + contract_date: str
  + status: str
  + generated_file_path: str | None
  + created_at: str | None
}

' Наследование
CamelModel <|-- Role
CamelModel <|-- User
CamelModel <|-- PropertyType
CamelModel <|-- RealEstateObject
CamelModel <|-- Photo
CamelModel <|-- Document
CamelModel <|-- Contract

' Связи
User "many" --> "one" Role : role_id
RealEstateObject "many" --> "one" PropertyType : property_type_id
RealEstateObject "one" --> "many" Photo : photos
RealEstateObject "one" --> "many" Document : documents
RealEstateObject "one" --> "many" Contract : contracts
Contract "many" --> "one" User : user_id
Contract "many" --> "one" User : manager_id

note right of User
  Пользователь системы
  (админ, менеджер, пользователь)
end note

note right of RealEstateObject
  Объект недвижимости
  (квартира, дом, коммерческая)
end note

note right of Contract
  Договор купли-продажи
  между покупателем и менеджером
end note

@enduml









